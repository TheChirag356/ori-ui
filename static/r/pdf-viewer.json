			"content": "<script lang=\"ts\" module>\n  export interface PdfRendererProps {\n    class?: string;\n  }\n</script>\n\n<script lang=\"ts\">\n  import { getContext, onMount, tick } from 'svelte';\n  import { cn } from '$LIB$/utils';\n  import type { PdfViewerContext } from './pdf-viewer-root.svelte';\n\n  let {\n    class: className = ''\n  }: PdfRendererProps = $props();\n\n  const context = getContext<PdfViewerContext>('pdfViewerContext');\n\n  let container: HTMLDivElement | null = $state(null);\n  let renderedPages = $state<Map<number, HTMLCanvasElement>>(new Map());\n  let renderingPages = $state<Set<number>>(new Set());\n  let renderVersion = $state(0); // Used to cancel stale renders\n\n  // Derived values from context\n  let currentPage = $derived(context.currentPage);\n  let zoom = $derived(context.zoom);\n  let pdf = $derived(context.pdf);\n  let totalPages = $derived(context.totalPages);\n  let viewMode = $derived(context.viewMode);\n\n  // Track previous zoom to detect changes\n  let prevZoom = $state(1);\n\n  async function renderSinglePage(pageNum: number, targetZoom: number, version: number): Promise<HTMLCanvasElement | undefined> {\n    if (!pdf) return undefined;\n    \n    // Check if this render is still relevant\n    if (version !== renderVersion) return undefined;\n\n    try {\n      const page = await pdf.getPage(pageNum);\n      \n      // Check again after async operation\n      if (version !== renderVersion) return undefined;\n      \n      const dpr = window.devicePixelRatio || 1;\n      const viewport = page.getViewport({ scale: targetZoom * dpr });\n\n      // Create a new canvas for double-buffering (render off-screen first)\n      const canvas = document.createElement('canvas');\n      canvas.className = 'pdf-page-canvas block shadow-lg rounded-sm';\n      canvas.dataset.page = String(pageNum);\n      \n      const ctx = canvas.getContext('2d');\n      if (!ctx) return undefined;\n\n      // Set canvas dimensions\n      canvas.width = viewport.width;\n      canvas.height = viewport.height;\n      canvas.style.width = `${viewport.width / dpr}px`;\n      canvas.style.height = `${viewport.height / dpr}px`;\n\n      // Enable high quality rendering\n      ctx.imageSmoothingEnabled = true;\n      ctx.imageSmoothingQuality = 'high';\n\n      // Render the page\n      await page.render({\n        canvasContext: ctx,\n        viewport,\n        canvas\n      }).promise;\n\n      // Final version check after render\n      if (version !== renderVersion) return undefined;\n\n      return canvas;\n    } catch (err: any) {\n      if (err?.name !== 'RenderingCancelled') {\n        console.error(`Error rendering PDF page ${pageNum}:`, err);\n      }\n      return undefined;\n    }\n  }\n\n  async function renderCurrentPage() {\n    if (!pdf || !container) return;\n    \n    const version = ++renderVersion;\n    const pageNum = currentPage;\n    const targetZoom = zoom;\n\n    // Check if we already have this page rendered at the current zoom\n    const existingCanvas = renderedPages.get(pageNum);\n    if (existingCanvas && prevZoom === targetZoom) {\n      // Just ensure it's displayed\n      updateSinglePageDisplay(existingCanvas);\n      return;\n    }\n\n    // If zoom changed, clear cache\n    if (prevZoom !== targetZoom) {\n      renderedPages = new Map();\n      prevZoom = targetZoom;\n    }\n\n    // Check if already rendering this page\n    if (renderingPages.has(pageNum)) return;\n\n    renderingPages = new Set([...renderingPages, pageNum]);\n\n    const canvas = await renderSinglePage(pageNum, targetZoom, version);\n    \n    renderingPages = new Set([...renderingPages].filter(p => p !== pageNum));\n\n    if (canvas && version === renderVersion) {\n      renderedPages = new Map([...renderedPages, [pageNum, canvas]]);\n      updateSinglePageDisplay(canvas);\n    }\n  }\n\n  function updateSinglePageDisplay(canvas: HTMLCanvasElement) {\n    if (!container) return;\n    \n    // Only update if needed - this prevents flickering\n    const existingCanvas = container.querySelector('canvas');\n    if (existingCanvas && \n        existingCanvas.dataset.page === canvas.dataset.page && \n        existingCanvas.width === canvas.width) {\n      return; // Already showing this canvas\n    }\n\n    // Smooth transition: add new canvas, then remove old ones\n    container.appendChild(canvas);\n    \n    // Remove old canvases after a tiny delay to prevent flash\n    requestAnimationFrame(() => {\n      const canvases = container?.querySelectorAll('canvas');\n      canvases?.forEach(c => {\n        if (c !== canvas) {\n          c.remove();\n        }\n      });\n    });\n  }\n\n  async function renderAllPages() {\n    if (!pdf || !container || totalPages === 0) return;\n    \n    const version = ++renderVersion;\n    const targetZoom = zoom;\n\n    // If zoom changed, clear cache\n    if (prevZoom !== targetZoom) {\n      renderedPages = new Map();\n      prevZoom = targetZoom;\n    }\n\n    // Clear container for scroll view\n    container.innerHTML = '';\n\n    // Render all pages\n    for (let i = 1; i <= totalPages; i++) {\n      if (version !== renderVersion) break;\n\n      // Check cache first\n      let canvas: HTMLCanvasElement | undefined = renderedPages.get(i);\n      \n      if (!canvas) {\n        renderingPages = new Set([...renderingPages, i]);\n        const newCanvas = await renderSinglePage(i, targetZoom, version);\n        renderingPages = new Set([...renderingPages].filter(p => p !== i));\n        \n        if (newCanvas) {\n          canvas = newCanvas;\n          renderedPages = new Map([...renderedPages, [i, canvas]]);\n        }\n      }\n\n      if (canvas && version === renderVersion && container) {\n        // Create page wrapper\n        const wrapper = document.createElement('div');\n        wrapper.className = 'pdf-page-wrapper mb-4 last:mb-0';\n        wrapper.dataset.page = String(i);\n        \n        // Clone canvas for display\n        const displayCanvas = canvas.cloneNode(true) as HTMLCanvasElement;\n        const ctx = displayCanvas.getContext('2d');\n        ctx?.drawImage(canvas, 0, 0);\n        \n        wrapper.appendChild(displayCanvas);\n        container.appendChild(wrapper);\n      }\n    }\n  }\n\n  // Handle scroll to update current page in scroll mode\n  function handleScroll() {\n    if (viewMode !== 'scroll' || !container) return;\n    \n    const wrappers = container.querySelectorAll('.pdf-page-wrapper');\n    const containerRect = container.getBoundingClientRect();\n    const containerMiddle = containerRect.top + containerRect.height / 2;\n\n    let closestPage = 1;\n    let closestDistance = Infinity;\n\n    wrappers.forEach((wrapper) => {\n      const rect = wrapper.getBoundingClientRect();\n      const pageMiddle = rect.top + rect.height / 2;\n      const distance = Math.abs(pageMiddle - containerMiddle);\n      \n      if (distance < closestDistance) {\n        closestDistance = distance;\n        closestPage = parseInt(wrapper.getAttribute('data-page') || '1', 10);\n      }\n    });\n\n    if (closestPage !== context.currentPage) {\n      context.setPage(closestPage);\n    }\n  }\n\n  // Re-render when relevant state changes\n  $effect(() => {\n    if (pdf && totalPages > 0) {\n      if (viewMode === 'single') {\n        // Single page mode: render current page\n        if (currentPage && zoom) {\n          renderCurrentPage();\n        }\n      } else {\n        // Scroll mode: render all pages\n        if (zoom) {\n          renderAllPages();\n        }\n      }\n    }\n  });\n\n  onMount(() => {\n    return () => {\n      // Cleanup: increment version to cancel pending renders\n      renderVersion++;\n    };\n  });\n</script>\n\n<div\n\tbind:this={container}\n\tclass={cn(\n\t\t'pdf-renderer relative overflow-auto',\n\t\tviewMode === 'single' ? 'flex items-center justify-center' : 'flex flex-col items-center',\n\t\tclassName\n\t)}\n\tonscroll={viewMode === 'scroll' ? handleScroll : undefined}\n>\n\t{#if renderingPages.size > 0 && renderedPages.size === 0}\n\t\t<div class=\"flex items-center justify-center p-8\">\n\t\t\t<div\n\t\t\t\tclass=\"h-6 w-6 animate-spin rounded-full\"\n\t\t\t\tstyle=\"border: 2px solid hsl(var(--primary)); border-top-color: transparent;\"\n\t\t\t></div>\n\t\t</div>\n\t{/if}\n</div>\n\n<style>\n  .pdf-renderer :global(canvas) {\n    max-width: 100%;\n    height: auto;\n  }\n  \n  .pdf-renderer :global(.pdf-page-wrapper) {\n    display: flex;\n    justify-content: center;\n  }\n</style>\n",
			"type": "registry:file",
			"target": "ori/pdf-viewer/pdf-renderer.svelte"
		},
